<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.down.payment.product</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="sale.res_config_settings_view_form_sale_inherit"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='downpayment_account_id']/.." position="after">
                <div class="row mt8">
                    <label
                        for="l10n_ro_sale_down_payment_product_id"
                        class="col-lg-5 o_light_label"
                    />
                    <field
                        name="l10n_ro_sale_down_payment_product_id"
                        context="{'default_type': 'service'}"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>

#: model:ir.model.fields,field_description:nexterp_stock_inventory_retail.field_l10n_ro_stock_inventory__l10n_ro_retail_markup_value
msgid "Markup Difference (378)"
msgstr "Diferență adaos comercial (378)"

#. module: nexterp_stock_inventory_retail
#: model:ir.model.fields,help:nexterp_stock_inventory_retail.field_l10n_ro_stock_inventory__l10n_ro_retail_value
msgid ""
"Net value of the differences at shelf price: the cost difference plus the "
"markup and the deferred VAT that go with it."
msgstr ""
"Valoarea netă a diferențelor la preț de vânzare: diferența de cost plus "
"adaosul comercial și TVA neexigibilă aferente."

#. module: nexterp_stock_inventory_retail
#: model:ir.model.fields,help:nexterp_stock_inventory_retail.field_l10n_ro_stock_inventory__l10n_ro_retail_markup_value
msgid ""
"Net value the inventory differences put on, or take off, the commercial "
"markup account."
msgstr ""
"Valoarea netă cu care diferențele de inventar încarcă sau descarcă contul de"
" adaos comercial."

#. module: nexterp_stock_inventory_retail
#: model:ir.model.fields,help:nexterp_stock_inventory_retail.field_l10n_ro_stock_inventory__l10n_ro_retail_vat_value
msgid ""
"Net value the inventory differences put on, or take off, the deferred VAT "
"account."
msgstr ""
"Valoarea netă cu care diferențele de inventar încarcă sau descarcă contul de"
" TVA neexigibilă."

#. module: nexterp_stock_inventory_retail
#: model_terms:ir.ui.view,arch_db:nexterp_stock_inventory_retail.report_stock_inventory_document

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_category_ro_mrp_wip_form" model="ir.ui.view">
        <field name="name">view_product_category_ro_mrp_wip_form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="stock_account.view_category_property_form" />
        <field name="priority" eval="50" />
        <field name="arch" type="xml">
            <field name="property_stock_valuation_account_id" position="after">
                <field name="is_l10n_ro_record" invisible="1" />
                <field
                    name="property_account_production_wip_account_id"
                    invisible="not is_l10n_ro_record"
                />
                <field
                    name="property_account_production_wip_overhead_account_id"
                    invisible="not is_l10n_ro_record"
                />
            </field>
        </field>
    </record>
</odoo>

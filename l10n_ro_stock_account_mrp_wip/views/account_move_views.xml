<odoo>
    <record id="view_move_form_inherit_mrp_wip_account" model="ir.ui.view">
        <field name="name">account.move.inherit.mrp.wip.account</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@id='other_tab_entry']//field[@name='company_id']"
                position="after"
            >
                <field
                    name="l10n_ro_wip_workorder_id"
                    invisible="not l10n_ro_wip_workorder_id"
                />
            </xpath>
        </field>
    </record>
</odoo>

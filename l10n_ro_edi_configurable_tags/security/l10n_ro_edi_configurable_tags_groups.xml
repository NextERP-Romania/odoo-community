<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        A dedicated group, granted to nobody by default: the rules decide what
        leaves the company towards ANAF, so editing them is a deliberate
        permission and not a side effect of being allowed to edit a partner.
    -->
    <record id="res_groups_privilege_l10n_ro_edi_xml" model="res.groups.privilege">
        <field name="name">E-Factura XML</field>
        <field name="category_id" ref="base.module_category_accounting" />
        <field name="sequence">90</field>
    </record>

    <record id="group_l10n_ro_edi_xml_rule_manager" model="res.groups">
        <field name="name">Manage e-Factura XML rules</field>
        <field name="privilege_id" ref="res_groups_privilege_l10n_ro_edi_xml" />
        <field
            name="comment"
        >Allows to configure which CIUS-RO XML nodes are filled for each partner, and where their value comes from.</field>
    </record>
</odoo>

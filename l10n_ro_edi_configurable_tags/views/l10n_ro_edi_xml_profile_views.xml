<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ro_edi_xml_profile_view_list" model="ir.ui.view">
        <field name="name">l10n_ro.edi.xml.profile.list</field>
        <field name="model">l10n_ro.edi.xml.profile</field>
        <field name="arch" type="xml">
            <list string="e-Factura XML profiles">
                <field name="name" />
                <field name="partner_count" string="Partners" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="l10n_ro_edi_xml_profile_view_form" model="ir.ui.view">
        <field name="name">l10n_ro.edi.xml.profile.form</field>
        <field name="model">l10n_ro.edi.xml.profile</field>
        <field name="arch" type="xml">
            <form string="e-Factura XML profile">
                <header>
                    <button
                        name="action_import_json"
                        type="object"
                        string="Import JSON"
                        groups="base.group_system"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_partners"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users"
                        >
                            <field
                                name="partner_count"
                                widget="statinfo"
                                string="Partners"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. Retail GS1" />
                        </h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="active" invisible="1" />
                    </group>
                    <notebook>
                        <page string="Rules" name="rules">
                            <field name="rule_ids" />
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1" />
                        </page>
                        <page string="JSON" name="json" groups="base.group_system">
                            <field name="json_export" widget="CopyClipboardText" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_ro_edi_xml_profile_view_search" model="ir.ui.view">
        <field name="name">l10n_ro.edi.xml.profile.search</field>
        <field name="model">l10n_ro.edi.xml.profile</field>
        <field name="arch" type="xml">
            <search string="e-Factura XML profiles">
                <field name="name" />
                <field name="partner_ids" string="Partner" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="l10n_ro_edi_xml_profile_action" model="ir.actions.act_window">
        <field name="name">e-Factura XML profiles</field>
        <field name="res_model">l10n_ro.edi.xml.profile</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first XML profile</p>
            <p>
                A profile groups the CIUS-RO nodes that a family of customers
                wants filled in a specific way, so you configure them once and
                attach the profile to every partner concerned.
            </p>
        </field>
    </record>
</odoo>

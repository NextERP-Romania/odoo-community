<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Traffic-light on purchase order lines (reception readiness). -->
    <record id="purchase_order_form_availability" model="ir.ui.view">
        <field name="name">purchase.order.line.availability.semaphore</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_qty']" position="after">
                <field name="availability_status_code" column_invisible="True"/>
                <field name="availability_status_label" column_invisible="True"/>
                <field name="availability_ratio" column_invisible="True"/>
                <widget name="availability_semaphore"/>
            </xpath>
        </field>
    </record>

</odoo>

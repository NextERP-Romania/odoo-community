<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Traffic-light column on the Manufacturing Orders list.
         components_availability_state / components_availability are already loaded. -->
    <record id="mrp_production_tree_view_availability" model="ir.ui.view">
        <field name="name">mrp.production.tree.availability.semaphore</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='components_availability']" position="after">
                <widget name="availability_semaphore"/>
            </xpath>
        </field>
    </record>

    <!-- Per-component traffic-light in the MO form (Components tab).
         state / product_uom_qty / product_qty / quantity / forecast_availability
         are already present in the move_raw_ids tree. -->
    <record id="mrp_production_form_view_availability" model="ir.ui.view">
        <field name="name">mrp.production.form.availability.semaphore</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']/tree/field[@name='forecast_availability'][@widget='forecast_widget']" position="after">
                <widget name="availability_semaphore"/>
            </xpath>
        </field>
    </record>

</odoo>

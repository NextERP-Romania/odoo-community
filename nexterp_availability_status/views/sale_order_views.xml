<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Traffic-light on sale order lines.
         product_uom_qty is native; free_qty_today / qty_available_today /
         forecast_expected_date are loaded by sale_stock's qty-at-date widget. -->
    <record id="view_order_form_availability" model="ir.ui.view">
        <field name="name">sale.order.line.availability.semaphore</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='qty_delivered']" position="after">
                <widget name="availability_semaphore"/>
            </xpath>
        </field>
    </record>

</odoo>

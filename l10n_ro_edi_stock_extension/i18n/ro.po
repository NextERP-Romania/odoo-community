# ==============================================================================
# Validation / error messages from _()
# ==============================================================================
#. module: l10n_ro_edi_stock_extension
msgid "Operation scope %(scope)s is not allowed for type %(op)s. Allowed values: %(allowed)s"
msgstr "Scopul operațiunii %(scope)s nu este permis pentru tipul %(op)s. Valori permise: %(allowed)s"

#. module: l10n_ro_edi_stock_extension
msgid "For operation 30 (National transport), the commercial partner must be from RO."
msgstr "Pentru operațiunea 30 (Transport național), partenerul comercial trebuie să fie din RO."

#. module: l10n_ro_edi_stock_extension
msgid "For operation %(op)s the partner country code (%(cc)s) must be EU and different from RO."
msgstr "Pentru operațiunea %(op)s codul țării partenerului (%(cc)s) trebuie să fie din UE și diferit de RO."

#. module: l10n_ro_edi_stock_extension
msgid "For operation %(op)s (Import/Export) the partner country code (%(cc)s) must be outside the EU."
msgstr "Pentru operațiunea %(op)s (Import/Export) codul țării partenerului (%(cc)s) trebuie să fie din afara UE."

#. module: l10n_ro_edi_stock_extension
msgid "For operation %(op)s at least one previous notification is required."
msgstr "Pentru operațiunea %(op)s trebuie completată cel puțin o notificare anterioară."

#. module: l10n_ro_edi_stock_extension
msgid "The following products are missing a tariff (NC8) code: %(names)s"
msgstr "Următoarele produse nu au cod tarifar (NC8) configurat: %(names)s"

#. module: l10n_ro_edi_stock_extension
msgid "The following products have 0 net weight: %(names)s"
msgstr "Următoarele produse au greutate netă 0: %(names)s"

#. module: l10n_ro_edi_stock_extension
msgid "The following products have 0 value (check the price source): %(names)s"
msgstr "Următoarele produse au valoare 0 (verifică sursa de preț): %(names)s"

#. module: l10n_ro_edi_stock_extension
msgid "Gross weight must be > 0 for %(p)s."
msgstr "Greutatea brută trebuie să fie > 0 pentru %(p)s."

#. module: l10n_ro_edi_stock_extension
msgid "Gross weight (%(g)s) must be >= net weight (%(n)s) for %(p)s."
msgstr "Greutatea brută (%(g)s) trebuie să fie mai mare sau egală cu greutatea netă (%(n)s) pentru %(p)s."

#. module: l10n_ro_edi_stock_extension
msgid "Document type is missing on an eTransport line."
msgstr "Lipsește tipul documentului pe o linie eTransport."

#. module: l10n_ro_edi_stock_extension
msgid "When document type is 'Other' (9999) the remarks field is mandatory (BR-026)."
msgstr "Pentru tipul de document 'Altele' (9999) câmpul observații este obligatoriu (BR-026)."

#. module: l10n_ro_edi_stock_extension
msgid "Document date is missing on an eTransport line."
msgstr "Lipsește data documentului pe o linie eTransport."

#. module: l10n_ro_edi_stock_extension
msgid "The transfer has no validated UIT."
msgstr "Transferul nu are UIT validat."

#. module: l10n_ro_edi_stock_extension
msgid "Confirmation type is required."
msgstr "Tipul de confirmare este obligatoriu."

#. module: l10n_ro_edi_stock_extension
msgid "Vehicle number is required."
msgstr "Numărul vehiculului este obligatoriu."

#. module: l10n_ro_edi_stock_extension
msgid "Modification date is required."
msgstr "Data modificării este obligatorie."

#. module: l10n_ro_edi_stock_extension
msgid "ANAF error on %(action)s: %(err)s"
msgstr "Eroare ANAF la %(action)s: %(err)s"

#. module: l10n_ro_edi_stock_extension
msgid "eTransport %(action)s sent successfully (UIT: %(uit)s, load: %(load)s)."
msgstr "eTransport %(action)s trimis cu succes (UIT: %(uit)s, încărcare: %(load)s)."

#. module: l10n_ro_edi_stock_extension
msgid "Number of days must be between 1 and 60."
msgstr "Numărul de zile trebuie să fie între 1 și 60."

#. module: l10n_ro_edi_stock_extension
msgid "ANAF error: %(err)s"
msgstr "Eroare ANAF: %(err)s"

#. module: l10n_ro_edi_stock_extension
msgid "Notification with errors found via ANAF LIST: %(m)s"
msgstr "Notificare cu erori găsită prin listarea ANAF: %(m)s"

#. module: l10n_ro_edi_stock_extension
msgid "Transport operator VAT is required."
msgstr "CIF organizator transport este obligatoriu."

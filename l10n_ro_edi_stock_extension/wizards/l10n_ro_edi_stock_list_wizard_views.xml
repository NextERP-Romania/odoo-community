<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_l10n_ro_edi_stock_list_wizard_form" model="ir.ui.view">
        <field name="name">l10n.ro.edi.stock.list.wizard.form</field>
        <field name="model">l10n.ro.edi.stock.list.wizard</field>
        <field name="arch" type="xml">
            <form string="eTransport notifications list">
                <group>
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="days" />
                </group>
                <field name="line_ids" readonly="1">
                    <list
                        decoration-danger="status == 'ERR'"
                        decoration-success="status == 'OK'"
                    >
                        <field name="notification_type" />
                        <field name="status" />
                        <field name="uit" />
                        <field name="operation_type" />
                        <field name="transport_date" />
                        <field name="partner_name" />
                        <field name="transporter_name" />
                        <field name="vehicle_number" />
                        <field name="messages" optional="hide" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_fetch"
                        type="object"
                        string="Query ANAF"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Close" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_ro_edi_stock_list_wizard" model="ir.actions.act_window">
        <field name="name">eTransport notifications list</field>
        <field name="res_model">l10n.ro.edi.stock.list.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_l10n_ro_edi_stock_list_wizard"
        name="eTransport notifications list"
        action="action_l10n_ro_edi_stock_list_wizard"
        parent="stock.menu_stock_inventory_control"
        sequence="200"
    />
</odoo>

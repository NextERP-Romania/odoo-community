<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_l10n_ro_edi_stock_action_wizard_form" model="ir.ui.view">
        <field name="name">l10n.ro.edi.stock.action.wizard.form</field>
        <field name="model">l10n.ro.edi.stock.action.wizard</field>
        <field name="arch" type="xml">
            <form string="eTransport notification action">
                <group>
                    <field name="picking_id" readonly="1" />
                    <field name="uit" readonly="1" />
                    <field name="action_type" />
                    <field name="remarks" />
                    <field name="post_outage" />
                </group>
                <group
                    string="Transport confirmation"
                    invisible="action_type != 'confirm'"
                >
                    <field
                        name="confirmation_type"
                        required="action_type == 'confirm'"
                    />
                </group>
                <group
                    string="Vehicle modification"
                    invisible="action_type != 'modify_vehicle'"
                >
                    <field
                        name="new_vehicle_number"
                        required="action_type == 'modify_vehicle'"
                    />
                    <field name="trailer_1_number" />
                    <field name="trailer_2_number" />
                    <field
                        name="modification_date"
                        required="action_type == 'modify_vehicle'"
                    />
                </group>
                <footer>
                    <button
                        name="action_execute"
                        type="object"
                        string="Send to ANAF"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="action_l10n_ro_edi_stock_action_wizard_delete"
        model="ir.actions.act_window"
    >
        <field name="name">Delete eTransport notification</field>
        <field name="res_model">l10n.ro.edi.stock.action.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_action_type': 'delete'}</field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_view_types">form</field>
    </record>

    <record
        id="action_l10n_ro_edi_stock_action_wizard_confirm"
        model="ir.actions.act_window"
    >
        <field name="name">Confirm eTransport transport</field>
        <field name="res_model">l10n.ro.edi.stock.action.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_action_type': 'confirm'}</field>
    </record>

    <record
        id="action_l10n_ro_edi_stock_action_wizard_modify_vehicle"
        model="ir.actions.act_window"
    >
        <field name="name">Modify eTransport vehicle</field>
        <field name="res_model">l10n.ro.edi.stock.action.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_action_type': 'modify_vehicle'}</field>
    </record>
</odoo>

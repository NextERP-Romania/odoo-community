<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        "eTransport" section of the Inventory menu, with three sub-menus:
          - Documents (this file): read-only list of all ANAF events
            (NOT / COR / DEL / CON / MVH) with search & group-by.
          - Notifications list (list wizard).
          - Transporters info (transporter info wizard).
        The section menu is declared here because this file is loaded before
        the two wizard view files, which attach their menus under it.
    -->
    <menuitem
        id="menu_l10n_ro_edi_stock_etransport_root"
        name="eTransport"
        parent="stock.menu_stock_root"
        sequence="90"
        groups="stock.group_stock_user"
    />

    <!-- ============================ Documents ============================ -->
    <record id="view_l10n_ro_edi_stock_document_list" model="ir.ui.view">
        <field name="name">l10n.ro.edi.stock.document.list</field>
        <field name="model">l10n_ro_edi.document</field>
        <field name="arch" type="xml">
            <list
                string="eTransport Documents"
                create="false"
                edit="false"
                delete="false"
                decoration-success="state in ('stock_sent', 'stock_validated')"
                decoration-danger="state == 'stock_sending_failed'"
                decoration-muted="state == 'stock_deleted'"
            >
                <field name="datetime" string="Date" />
                <field name="l10n_ro_edi_stock_event_type" string="Event" />
                <field name="state" />
                <field name="l10n_ro_edi_stock_uit" string="UIT" />
                <field name="picking_id" optional="show" />
                <field name="l10n_ro_edi_stock_load_id" optional="hide" />
                <field name="l10n_ro_edi_stock_confirm_type" optional="hide" />
                <field name="l10n_ro_edi_stock_modified_vehicle" optional="hide" />
                <field name="message" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_l10n_ro_edi_stock_document_form" model="ir.ui.view">
        <field name="name">l10n.ro.edi.stock.document.form</field>
        <field name="model">l10n_ro_edi.document</field>
        <field name="arch" type="xml">
            <form string="eTransport Document" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="l10n_ro_edi_stock_event_type" />
                            <field name="state" />
                            <field name="l10n_ro_edi_stock_uit" />
                            <field name="l10n_ro_edi_stock_load_id" />
                            <field name="datetime" />
                        </group>
                        <group>
                            <field name="picking_id" />
                            <field name="l10n_ro_edi_stock_confirm_type" />
                            <field name="l10n_ro_edi_stock_modified_vehicle" />
                            <field name="l10n_ro_edi_stock_modification_date" />
                        </group>
                    </group>
                    <group string="Message" invisible="not message">
                        <field name="message" nolabel="1" />
                    </group>
                    <group string="Attachment">
                        <field name="attachment" filename="l10n_ro_edi_stock_uit" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ro_edi_stock_document_search" model="ir.ui.view">
        <field name="name">l10n.ro.edi.stock.document.search</field>
        <field name="model">l10n_ro_edi.document</field>
        <field name="arch" type="xml">
            <search string="eTransport Documents">
                <field name="l10n_ro_edi_stock_uit" string="UIT" />
                <field name="picking_id" />
                <field name="l10n_ro_edi_stock_load_id" string="Load ID" />
                <separator />
                <filter
                    name="evt_not"
                    string="Notification (NOT)"
                    domain="[('l10n_ro_edi_stock_event_type', '=', 'NOT')]"
                />
                <filter
                    name="evt_cor"
                    string="Correction (COR)"
                    domain="[('l10n_ro_edi_stock_event_type', '=', 'COR')]"
                />
                <filter
                    name="evt_del"
                    string="Deletion (DEL)"
                    domain="[('l10n_ro_edi_stock_event_type', '=', 'DEL')]"
                />
                <filter
                    name="evt_con"
                    string="Confirmation (CON)"
                    domain="[('l10n_ro_edi_stock_event_type', '=', 'CON')]"
                />
                <filter
                    name="evt_mvh"
                    string="Vehicle Modification (MVH)"
                    domain="[('l10n_ro_edi_stock_event_type', '=', 'MVH')]"
                />
                <separator />
                <filter
                    name="state_validated"
                    string="Validated"
                    domain="[('state', '=', 'stock_validated')]"
                />
                <filter
                    name="state_sent"
                    string="Sent"
                    domain="[('state', '=', 'stock_sent')]"
                />
                <filter
                    name="state_failed"
                    string="Error"
                    domain="[('state', '=', 'stock_sending_failed')]"
                />
                <group name="group_by">
                    <filter
                        name="group_event"
                        string="Event Type"
                        context="{'group_by': 'l10n_ro_edi_stock_event_type'}"
                    />
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_ro_edi_stock_document" model="ir.actions.act_window">
        <field name="name">eTransport Documents</field>
        <field name="res_model">l10n_ro_edi.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_ro_edi_stock_document_search" />
        <field name="domain">[
            ('state', 'in', [
                'stock_sent', 'stock_sending_failed', 'stock_validated',
                'stock_deleted', 'stock_confirmed', 'stock_vehicle_modified',
            ]),
        ]</field>
        <field name="context">{'search_default_group_event': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">No eTransport documents yet</p>
            <p>
                Every ANAF event (notification, correction, deletion,
                confirmation, vehicle modification) sent from a transfer or a
                batch transfer is recorded here.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_l10n_ro_edi_stock_document"
        name="Documents"
        action="action_l10n_ro_edi_stock_document"
        parent="menu_l10n_ro_edi_stock_etransport_root"
        sequence="10"
    />
</odoo>

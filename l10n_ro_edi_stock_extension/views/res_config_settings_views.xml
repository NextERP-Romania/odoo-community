<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record
        id="res_config_settings_view_form_l10n_ro_edi_stock_extension"
        model="ir.ui.view"
    >
        <field name="name">res.config.settings.form.l10n_ro_edi_stock_extension</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="l10n_ro_edi_stock.res_config_settings_form_inherit_l10n_ro_edi"
        />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='l10n_ro_edi_settings']" position="inside">
                <setting string="eTransport additional settings">
                    <div class="content-group">
                        <div class="row mt16">
                            <label
                                for="l10n_ro_edi_stock_default_price_source"
                                class="col-lg-4 o_light_label"
                            />
                            <field name="l10n_ro_edi_stock_default_price_source" />
                        </div>
                        <div class="row mt8">
                            <field name="l10n_ro_edi_stock_list_enabled" />
                            <label for="l10n_ro_edi_stock_list_enabled" />
                        </div>
                        <div class="row mt8">
                            <label
                                for="l10n_ro_edi_stock_list_days"
                                class="col-lg-4 o_light_label"
                            />
                            <field name="l10n_ro_edi_stock_list_days" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

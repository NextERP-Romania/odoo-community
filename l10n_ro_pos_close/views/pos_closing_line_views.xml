<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_pos_closing_line_list" model="ir.ui.view">
        <field name="name">l10n.ro.pos.closing.line.list</field>
        <field name="model">l10n.ro.pos.closing.line</field>
        <field name="arch" type="xml">
            <list
                string="Closing Control"
                create="0"
                delete="0"
                edit="0"
                decoration-danger="has_difference"
            >
                <field name="payment_method_id" />
                <field name="payment_method_type" />
                <field name="expected_amount" sum="Total" />
                <field name="counted_amount" sum="Total" />
                <field name="difference" sum="Total" />
                <field name="reason" />
                <field name="note" />
                <field name="has_difference" column_invisible="1" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>
</odoo>

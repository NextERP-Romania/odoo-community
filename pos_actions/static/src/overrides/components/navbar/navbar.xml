<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t
        t-name="pos_actions.Navbar"
        t-inherit="point_of_sale.Navbar"
        t-inherit-mode="extension"
    >
        <!-- The bar the point of sale ships keeps its line; the desks get
             one above it. The root is wrapped rather than added to, because
             a component has a single root and `$0` is how the original one
             is put back inside the wrapper. -->
        <xpath expr="//div[hasclass('pos-topheader')]" position="replace">
            <div class="pos-actions-wrapper d-flex flex-column">
                <div
                class="pos-actions-bar d-flex align-items-center gap-1 px-2 pt-2 bg-view"
            >
                <div class="btn-group" role="group" aria-label="Point of Sale Desks">
                    <button
                        t-foreach="this.posActionsAreas"
                        t-as="area"
                        t-key="area.id"
                        class="pos-actions-area btn btn-outline-secondary lh-lg"
                        t-att-class="{'active': area.id === this.posActionsActiveArea.id}"
                        t-att-data-area="area.id"
                        t-on-click="() => this.openPosActionsArea(area)"
                    >
                        <span t-if="!this.ui.isSmall" t-out="area.label" />
                        <i
                            t-else=""
                            class="oi oi-fw oi-lg"
                            t-att-data-icon="area.icon"
                        />
                        <span
                            t-if="this.posActionsCount(area)"
                            class="badge text-bg-primary ms-1"
                            t-out="this.posActionsCount(area)"
                        />
                    </button>
                </div>
            </div>
                $0
            </div>
        </xpath>
    </t>

</templates>

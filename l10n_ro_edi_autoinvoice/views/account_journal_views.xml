<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Deactivated while l10n_ro_account_enterprise shows the same fields
         (see account.journal._register_hook). -->
    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_email_alias']" position="after">
                <group
                    string="Ro Auto Invoicing"
                    invisible="type not in ('sale', 'purchase')"
                >
                    <field name="l10n_ro_sequence_type" />
                    <field
                        name="l10n_ro_partner_id"
                        invisible="l10n_ro_sequence_type == 'normal'"
                        required="l10n_ro_sequence_type != 'normal'"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>

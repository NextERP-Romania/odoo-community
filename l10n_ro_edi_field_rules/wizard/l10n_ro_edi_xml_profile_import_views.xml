<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_ro_edi_xml_profile_import_view_form" model="ir.ui.view">
        <field name="name">l10n_ro.edi.xml.profile.import.form</field>
        <field name="model">l10n_ro.edi.xml.profile.import</field>
        <field name="arch" type="xml">
            <form string="Import rules">
                <group>
                    <field name="profile_id" readonly="1" />
                    <field name="mode" widget="radio" />
                </group>
                <field
                    name="json_text"
                    placeholder="Paste here the JSON of the source profile"
                />
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>

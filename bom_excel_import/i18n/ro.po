#. module: bom_excel_import
#: model_terms:ir.ui.view,arch_db:bom_excel_import.view_bom_excel_import_wizard_form
msgid ""
"<strong>Import Completed Successfully!</strong><br/>\n"
"                        Your BOMs have been imported from the Excel file."
msgstr ""
"<strong>Importul s-a finalizat cu succes!</strong><br/>\n"
"                        LMF-urile dvs. au fost importate din fișierul Excel."

#. module: bom_excel_import
#: model_terms:ir.ui.view,arch_db:bom_excel_import.view_bom_excel_import_wizard_form
msgid ""
"<strong>Step 1: Upload Excel File</strong><br/>\n"
"                        Upload your Excel file containing BOM data.<br/>\n"
"                        <strong>Expected Excel format:</strong><br/>\n"
"                        - Column 1: Product produced<br/>\n"
"                        - Column 2: Operation name<br/>\n"
"                        - Column 3: Quantity consumed<br/>\n"
"                        - Column 4: Component consumed UOM<br/>\n"
"                        - Column 5: Component consumed<br/>\n"
"                        - Column 6: Workcenter name<br/>\n"
"                        - Column 7: Subcontracting<br/>\n"
"                        - Column 8: Subcontractors (comma-separated)<br/>"
msgstr ""
"<strong>Pasul 1: Încărcați fișierul Excel</strong><br/>\n"
"                        Încărcați fișierul Excel care conține datele LMF.<br/>\n"
"                        <strong>Formatul Excel așteptat:</strong><br/>\n"
"                        - Coloana 1: Produs fabricat<br/>\n"
"                        - Coloana 2: Denumire operațiune<br/>\n"
"                        - Coloana 3: Cantitate consumată<br/>\n"
"                        - Coloana 4: UOM componentă consumată<br/>\n"
"                        - Coloana 5: Componentă consumată<br/>\n"
"                        - Coloana 6: Denumire centru de lucru<br/>\n"
"                        - Coloana 7: Subcontractare<br/>\n"
"                        - Coloana 8: Subcontractanți (separați prin virgulă)<br/>"

#. module: bom_excel_import
#: model_terms:ir.ui.view,arch_db:bom_excel_import.view_bom_excel_import_wizard_form
msgid ""
"<strong>Step 2: Import Operations and Workcenters</strong><br/>\n"
"                        This step will create workcenters and operations from your Excel file.<br/>\n"
"                        Click \"Import Operations\" to proceed."
msgstr ""
"<strong>Pasul 2: Importați operațiunile și centrele de lucru</strong><br/>\n"
"                        Acest pas va crea centrele de lucru și operațiunile din fișierul dvs. Excel.<br/>\n"
"                        Faceți clic pe \"Importați operațiunile\" pentru a continua."

#. module: bom_excel_import
#: model_terms:ir.ui.view,arch_db:bom_excel_import.view_bom_excel_import_wizard_form
msgid ""
"<strong>Step 3: Import Bills of Materials</strong><br/>\n"
"                        Operations have been imported successfully. Now import the BOMs.<br/>\n"
"                        Click \"Import BOMs\" to proceed."
msgstr ""
"<strong>Pasul 3: Importați listele de materiale</strong><br/>\n"
"                        Operațiunile au fost importate cu succes. Acum importați LMF-urile.<br/>\n"
"                        Faceți clic pe \"Importați LMF-urile\" pentru a continua."


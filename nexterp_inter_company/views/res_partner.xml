<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_partner_inter_company" model="ir.ui.view">
        <field name="name">view_res_partner_inter_company</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- Odoo 20 dropped company_type; what it used to say is now read
                 on is_company, computed from the partner being its own
                 commercial entity with a valid vat. The flag sits under the
                 identifiers block, in the same group. -->
            <xpath expr="//div[@name='identifiers']" position="after">
                <field name="is_company" invisible="1" />
                <field name="is_inter_company" invisible="not is_company" />
            </xpath>
        </field>
    </record>
</odoo>
